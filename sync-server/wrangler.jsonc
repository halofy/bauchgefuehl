{
  "name": "bauchgefuehl-sync",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "vars": {
    "ALLOWED_ORIGINS": "https://DEIN-NAME.github.io"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SyncRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }],
  "observability": { "enabled": false }
}
